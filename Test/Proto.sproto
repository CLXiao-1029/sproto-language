        openId 3 : string  # 帐号编号
    }
    response { }
}

# 登录帐号
Login 1002 {
    request {
        serverId 1 : integer  # 服务器编号
        channel 2 : string  # 帐号渠道
        openId 3 : string  # 帐号编号
        userId 4 : integer  # 玩家编号

        platform 10 : string  # 游戏平台
        appInfo 11 : string  # 应用信息(json)
        abCaseCol 12 : *string  # AB测试规则列表

        devId 13 : string # 设备id
    }
    response {
        userId 1 : integer  # 玩家编号
        banTime 2 : integer  # 封禁时间
        banReason 3 : string   # 封禁原因

        born 10 : boolean  # 新建玩家
        userData 11 : UserData   # 玩家数据

        abCaseCol 20 : *string  # AB测试规则列表
        abConfig 21 : string  # AB测试配置(json)

        commitId 30 : string # Shared_Data提交号

        newDevice 31 : boolean # 是否为新设备
        guildId 32 : integer # 公会id 需判空

        isWarBlackUser 33 : boolean # 是否war黑名单用户
    }
}

# 退出帐号
Logout 1003 {
    request { }
}

# 踢出玩家
NotifyKick 1004 {
    request {
        message 1 : string  # 原因说明
    }
}

# 聊天发言
# 由前端调用
ChatSay 1005 {
    request {
        # 频道
        # 1 世界
        # 2 公会招募
        channel 1 : integer

        # 聊天文本
        text 2 : string
    }
}

# 聊天推送
.sChatMessage {

    # 发言时间
    time 1 : integer

    # 频道
    # 1 世界
    # 2 公会招募
    channel 2 : integer

    # 玩家、公会信息
    player 3 : sWarPlayer # name, avatar
    guild 4 : GuildData # name, flag, guildId
    
    # 发言文本
    text 5 : string 
}

ChatPushMessage 1006 {
    request {
        msg 1 : sChatMessage
    }
}

# 拉取历史聊天消息
