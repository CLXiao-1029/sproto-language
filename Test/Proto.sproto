# 公会战力排行榜
WarRankGuildPower 7080 {
    request {
    }
    response {
        # 1 list仅包含钻石组到黑铁组的公会  
        # 2 数组下标就是排位序号
        # 3 公会所属分组 由前端根据排位序号 查找war_guildgroup确定
