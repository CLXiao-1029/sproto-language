    }
}

# 公会副本 领取活跃奖励
GuildDungeonReceiveActive 6023 {
    request {
        id 1 : integer # 奖励id
    }
}

#############################################
# 荒野战争
#############################################
.sWarBuff {
    id 1 : integer # buff id
    extraInt 2 : integer # 扩展整数字段 目前用于存储buff(id=201)的等级

    # 对应公会战rougelike 城市buff
    expiry 3 : integer # 到期时间
    cityId 4 : integer # buff依附的城市
}

.sWarPlayerLog {
    .LogArgCommon {
        isSenderWin 1 : boolean # 发送方是否胜利
        sender 2 : sWarPlayer # faction, userId, name, title, cityId, aiId
        recver 3 : sWarPlayer # 同上
        senderDelta 4 : integer # 发送方hp变化量
        recverDelta 5 : integer # 接收方hp变化量
    }

    .LogArgSkill {
        sender 1 : sWarPlayer # 施放技能的玩家 title, name
        skillId 2 : integer # 技能id
        cityId 3 : integer # 技能目标城市
        hpDelta 4 : integer # hp变化量
    }

    type 1 : integer # 1战斗 2治疗 3技能
    time 2 : integer # 事件戳
    arg1 3 : LogArgCommon # 根据type的值 读取对应的arg字段
    arg2 4 : LogArgCommon
    arg3 5 : LogArgSkill
}

.sWarPlayerFlag {
    player 1 : sWarPlayer # faction, avatar, title, name
    expiry 2 : integer
}

.sWarGift {
    giftId 1 : integer # 礼包id 指向item表
    sender 2 : sWarPlayer # 赠送者 avatar, title, name
    guildFlag 3 : GuildFlag # 赠送者的公会旗帜
    guildName 4 : ColorText # 赠送者的公会名字
    claimed 5 : boolean # 是否已领取
}

.sWarPlayer {
    userId 1 : integer
    name 2 : ColorText # 如果是ai玩家(faciton == WarEnum.FACTION_AI 或者 aiId字段有值) 则name.text是多语言key
    avatar 3 : PlayerAvatar
    guildId 4 : integer # 公会id
    faction 5 : integer # 阵营id
    power 6 : integer # 战力
    honor 7 : integer # 军功
    title 8 : integer # 军衔
    cityId 9 : integer # 所在城市的id
    hpMax 10 : integer # hp(城防)最大值
    hpCur 11 : integer # hp(城防)当前值
    skillCooling 12 : *KVIntInt() # 冷却中的个人技能 key: 技能id, value: 冷却完成时间戳
    buffDict 13 : *sWarBuff(id) # buff字典
    logs 14 : *sWarPlayerLog # 战报列表
    nSendCure 15 : integer # 发送治疗次数
    nRecvCure 16 : integer # 接收治疗次数
    nAttack 17 : integer # 进攻次数
    nDefend 18 : integer # 防守次数
    nflagUsed 19 : integer # 插旗次数
    nWinStreak 20 : integer # 连胜次数
    guildFlag 21 : GuildFlag # 公会旗帜
    guildName 22 : ColorText # 公会名

    rougeBonus 23 : *KVIntInt() # rouge玩法加成型奖励 key是cfgId指向war_rougelike表 value是等级 玩家选1次 加1级
    rougeChanceLogin 24 : integer # 登录相关的 剩余可用3选1机会
    rougeChanceTitle 25 : integer # 军衔相关的 剩余可用3选1机会
    rougeAdRefresh 26 : boolean # 是否可以广告刷新3选1候选
    rougeRandSeed 27 : integer # 用于产生3选1候选的随机种子
    rougeFreeMove 28 : boolean # 肉鸽 死灰复燃标记

    giftList 29 : *sWarGift # 大佬恩赐的礼包数组 

    aiId 90 : integer # ai玩家的配置表id 指向war_city_ai表
}

.sWarCity {
    id 1 : integer
    faction 2 : integer # 所属阵营
    defenders 3 : *sWarPlayer(userId) # 守军列表 注意: 仅WarCityDetail协议会填充此字段

    # 各阵营的最大军旗到期时间
    # key: 阵营id
    # value: 该阵营军旗最大的到期时间 若serverTime < value 则军旗有效
    factionFlags 4 : *KVIntInt() 

    occupyTime 5 : integer # 占领开始时间
    defenderCnt 6 : integer # 守军数量
    combatIntensity 7 : integer(6) # 战斗烈度
    factionFlagCnt 8 : *integer # 数组下标对应阵营id 值是该阵营旗帜数量

    buffDict 9 : *sWarBuff(id) # buff字典
}


.sWarConfig {
    wall_pfix 1 : *integer(3) # 修复城防惩罚
    wall_rmfix 2 : integer(3) # 修复自身损失
}

.sWarGame {
    seasonId 1 : integer
    seasonEndTime 2 : integer # 赛季结束时间
    gameId 3 : integer # 忽略
    groupLv 4 : integer # 分组级别 指向war_guildgroup表
    cityDict 5 : *sWarCity(id) # 城市列表
    skillCooling 6 : *KVIntInt() # 冷却中的全局技能 技能id : 冷却完成时间

    you 7 : sWarPlayer # 请求sWarGame的玩家自身数据

    # 你所在阵营的领袖 影响发布阵营宣言的权限 userId, name, title, avatar, faction
    # 不一定有值 注意判空!!!
    leader 8 : sWarPlayer 

    factionNotice 9 : string # 阵营宣言 默认值是空字符串
    guildNotice 10 : string # 公会宣言 默认值是空字符串

    # 发布阵营公告的玩家 初始为nil
    # title, name, avatar, faction, guildFlag, guildName
    factionNoticeLeader 11 : sWarPlayer 

    config 12 : sWarConfig # 后端下发的易变配置
}


.LocalizedArg {
    # 1 arg是多语言key 
    # 2 arg是直接使用的值
    type 1 : integer 
    arg 2 : string
}

.sWarMessage {
    .sChat {
        guild 1 : GuildData # name, flag有赋值
        player 2 : sWarPlayer # name, avatar, title有值
        type 3 : integer # 文本类型 1直接显示 2多语言
        args 4 : *LocalizedArg # 文本参数
    }

    .sUseFlag {
        player 1 : sWarPlayer # faction, title, name
        cityId 2 : integer
        expiry 3 : integer # 用player.faction 以及expiry字段 可更新该阵营军旗的最大超时
    }

    .sBeatPlayer {
        sender 1 : sWarPlayer # faction, title, name, aiId
        recver 2 : sWarPlayer # 同上
        cityId 3 : integer
    }

    .sCityExchange {
        # 同志们要注意下
        # player.faction 是易主后的阵营
        # city.faction 是易主前的阵营
        player 1 : sWarPlayer # faction, name, title
        city 2 : sWarCity # id, faction
    }

    .sUseSkill {
        city 1 : sWarCity # id, faction
        fromFaction 2 : integer # 释放技能的阵营
        skillId 3 : integer
        sender 4 : sWarPlayer # 释放此技能的玩家 title, name, userId
    }

    .sUpdateBuff {
        type 1 : integer # 1增加或覆盖 2移除
        buff 2 : sWarBuff
    }

    .sFactionNotice {
        notice 1 : string
        leader 2 : sWarPlayer # 发布公告的玩家 title, name, avatar, faction, guildFlag, guildName
    }

    channel 99 : integer # 频道 1世界 2阵营 3公会
    type 98 : integer # 类型 1聊天 2军衔变更 ...
    time 97 : integer # 时间

    arg1 1 : sChat

    # 数组包含所有军衔变动的玩家 前端需要处理:
    # 1 确定数组中是否包含自己 如果是 则应用新数据到本地
    # 2 从中找出每个阵营的大元帅(title=29) 然后按需求生成大元帅变更系统消息
    arg2 2 : *sWarPlayer # hpCur, hpMax, faction, name, title, buffDict, rougeChanceTitle 有赋值

    arg3 3 : sFactionNotice # 阵营公告文本
    arg4 4 : sUseFlag
    arg5 5 : sBeatPlayer
    arg6 6 : sCityExchange # id, faction, occupyTime, defenderCnt
    arg7 7 : sUseSkill
    arg8 8 : sWarPlayer # 包含全部字段 cityId已更新为主城id hpCur等字段也有重置
    arg9 9 : sWarPlayerLog
    arg10 10 : *integer # 守军数量归0的cityId列表
    arg11 11 : *integer # 守军数量从0变为非0的的cityId列表
    arg12 12 : *sUpdateBuff # 按此字段各个元素的类型 更新本地自身玩家的buffDict
    arg13 13 : *sWarPlayer # 当被治疗、攻击时触发 从中找到自己 并应用userId, hpCur, hpMax
    arg14 14 : KVIntInt # key是全局技能id val是冷却到期时间戳
    arg15 15 : *sWarPlayer # 更新各阵营领袖 userId, name, title, avatar, faction
    arg16 16 : string # 公会公告文本
    arg17 17 : integer # 赛季进入战斗阶段 此字段的值无意义
    arg18 18 : *KVIntInt # 守军人数变动的城市列表 对于每个KVIntInt key是城市id val是守军人数
    arg19 19 : *sWarCity # 旗帜数量发生变化的城市列表 对于每个元素 id, factionFlagCnt有填充
    arg20 20 : *sUpdateBuff # 按照此列表的顺序 根据cityId关连到城市 根据type执行对应操
    arg21 21 : sWarGift # 受赠礼包 将该字段的值 table.insert到自己WarPlayer.giftList
}

# 登录
WarLogin 7001 {
    request {}
    response {
        err 1 : integer # 0成功 1赛季准备中 9赛季已开始 但未加入 10通过进出不同公会 跨越战争副本
        prepareEndTime 2 : integer # 准备阶段结束时间 当err = 1
        seasonEndTime 3 : integer # 当前赛季结束事件 当err = 9
        guildRank 4 : integer # 本公会排名(小于0表示未进入排名) 当err = 1
        gameData 5 : sWarGame # 游戏数据 仅当err = 0
    }
}

# 查看城市详情
WarCityDetail 7002 {
    request {
        id 1 : integer
    }
    response {
        city 1 : sWarCity # id, faction, defeners, factionFlagCnt
        guildDict 2 : *GuildData(guildId) # name, flag
    }
}

# 移动到指定城市
WarCityMove 7003 {
    request {
        path 1 : *integer # 起点城市到终点城市的id列表
        isDstCityEmpty 2 : boolean # 目标城市是不是空城
    }
    response {
        err 1 : integer
        cityId 2 : integer # 当前玩家 最新位置
    }
}

# 插旗
WarCityUseFlag 7004 {
    request {
        cityId 1 : integer
    }
    response {
    }
}

# 查看军旗列表
WarCityFlagList 7005 {
    request {
        cityId 1 : integer
    }
    response {
        faction1 1 : *sWarPlayerFlag # 阵营1军旗列表 无军旗则是空数组
        faction2 2 : *sWarPlayerFlag 
        faction3 3 : *sWarPlayerFlag
    }
}

# 治疗
WarCityCurePlayer 7006 {
    request {
        recverId 1 : integer # 接受修复的userId
        times 2 : integer # 修复次数
    }
    response {
        err 1 : integer
        stone 2 : integer # 原石奖励
        hpDelta 3 : integer # 恢复量

    }
}

# 读取挂机奖励
WarCityCalcAfk 7007 {
    request {
    }
    response {
        count 1 : integer # 原石数量
        limit 2 : integer # 上限
        scale 3 : integer(3) # 与公会排名对应的缩放值 使用前应乘以100再取整
        guildRank 4 : *sWarRankGuild # 所属阵营的公会排名
    }
}

# 领取挂机奖励
WarCityClaimAfk 7008 {
    request {
    }
    response {
        count 1 : integer # 原石数量 应加入背包
    }
}

# 查询所有城市战斗烈度
WarCityQueryAllCombatIntensity 7009 {
    request {
    }
    response {
        dict 1 : *KVIntNum() # key是cityId value是战斗烈度
    }
}

# 获取联盟信息
WarAllianceInfo 7030 {
    request {}
    response {
        titleUpdateExpiry 1 : integer # 更新军衔超时时间
        cityCnt 2 : integer
        guildList 3 : *GuildData # name, flag, level, honor
        playerList 4 : *sWarPlayer # 按title分组 然后组内按honor排序 然后应用到ui
    }
}

# 更新公告
WarUpdateNotice 7031 {
    request {
        type 1 : integer # 1阵营公告 2公会公告
        notice 2 : string # 公告文本
    }
}

# 聊天
WarChat 7032 {
    request {
        channel 1 : integer # 频道 见Enum/War.lua定义
        type 2 : integer # 文本类型 1直接显示 2多语言
        args 3 : *LocalizedArg # 参数列表
    }
}

# 战争 拉取聊天记录
# 每个频道的记录 都按时间升序排列
WarPullChatRecords 7033 {
    request {}
    response {
        world   1 : *sWarMessage # 世界频道
        faction 2 : *sWarMessage # 阵营频道 
        guild   3 : *sWarMessage # 公会频道 
    }

}

# 战争消息推送
WarPushMessage 7040 {
    request {
        msg 1 : sWarMessage
    }
}

# 战斗开始
WarCombatBegin 7050 {
    request {
        recverId 1 : integer   # 防守方id
        enRate 2 : integer # 体力消耗倍率(必填字段)
    }
    response {
        err 1 : integer
    }
} 

# 战斗结算
WarCombatEnd 7051 {
    request {
        senderWin 1 : boolean # 进攻方是否胜利
        senderHpRatio 2 : integer(3) # 进攻方 剩余血量 百分比
        recverHpRatio 3 : integer(3) # 防守方 剩余血量 百分比
        senderShellRatio 4 : integer(3) # 进攻方 剩余护盾 百分比
        recverShellRatio 5 : integer(3) # 防守方 剩余护盾 百分比
    }

    response {
        err 1 : integer # 仅当err = err_ok 表示走完结算流程 you, stone字段才有意义
        you 2 : sWarPlayer # 字段更新后的你的玩家 hpCur, hpMax, honor, title, cityId, buffDict, rougeChanceTitle, rougeFreeMove
        stone 3 : integer # 原石奖励
        honorIncr 4 : integer # 军功增量
        senderHpDecr 5 : integer # 进攻方hp减量 (已是负值)
        senderHpDecrFlag 6 : integer # 进攻方hp减量中 属于防守方军旗的部分(已是负值)
        recverHpDecr 7 : integer # 同进攻方
        recverHpDecrFlag 8 : integer
        recverHpCur 9 : integer
        recverHpMax 10 : integer
        contri 11 : integer # 公会贡献币奖励
        isLastKill 12 : boolean # 是否完成最后一击 
    }
}

# 计算防守方hp减量
WarCombatCalcRecverHpDecr 7052 {
    request {
        recverId 1 : integer # 防守方id
        enRate 2 : integer # 体力消耗倍率(必填字段)
    }
    response {
        err 1 : integer # err = 0 recverHpDecr有填充 
        recverHpDecr 2 : integer # 防守方hp减量
    }
}

# 使用技能
# 1 前端应在本地先判断技能是否冷却完成
#   个人技能 在sWarPlayer.skillCooling判断冷却状态
#   全局技能 在sWarGame.skillCooling判断冷却状态
#
# 2 某些技能需要附加参数 应以技能的war_playerskill.group字段值拼出动态key 并赋值
# 3 与技能逻辑相关的返回值 后端以上一条相同的规则填充


.sSkillResultRetreat {
    player 1 : sWarPlayer
    enDelta 2 : integer # 体力增量 该字段值>=0
}

WarSkillUse 7060 {
    request {
        skillId 99 : integer

        # 注意: "arg"后面的数字后缀 不是技能id 而是技能的group 即war_playerskill.group字段
        # 4~7的技能group 需要指定目标城市
        arg4 4 : integer # 目标城市id
        arg5 5 : integer # 同上
        arg6 6 : integer # 同上
        arg7 7 : integer # 同上
    }

    response {
        err 99 : integer
        cdExpiry 98 : integer # 更新后的技能冷却到期时间

        # 注意: "arg"后面的数字后缀 不是技能id 而是技能的group 即war_playerskill.group字段
        arg1 1 : sWarPlayer # 回血 hpCur, hpMax
        arg2 2 : integer    # 回军令 字段值是军令增量 应加入本地背包
        arg3 3 : sSkillResultRetreat # 撤退 全字段有意义 因为可能撤回主城 从而触发属性、buff重置
        arg4 4 : sWarPlayer # 空降 同上
    }

}

# 公会战购买军令
WarBuyHonor 7070 {
    request {
        isAd 1 : boolean # 是否广告购买
    }
}

# 公会战按时间恢复军令
WarRecoverHonor 7071 {
    request {}
}

# 公会战领取军衔奖励
WarReceiveTitleReward 7072 {
    request {
        titleId 1 : integer
    }
}

