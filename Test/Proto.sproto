#########################################
# 混沌战争
#########################################
.sChaosWarBuff {
    id 1 : integer
    extraArg 2 : integer # 额外数据 目前用于疲劳buff等级
}

.sChaosWarLog {
    # 战斗日志
    .CombatLog {
        .Entry {
            player 1 : sChaosWarPlayer
            hpDelta 2 : integer
            expDelta 3 : integer
            coinDelta 4 : integer
            honorDelta 5 : integer
        }

        isSenderWin 1 : boolean
        sender 2 : Entry
        recver 3 : Entry
    }

    # 接收技能伤害日志
    .RecvSkillDamage {
        caster 1 : sChaosWarPlayer # 施法者 faction, name
        skillId 2 : integer # 技能id
        hpDelta 3 : integer # 伤害值
    }

    
    type 99 : integer # 日志类型
    time 98 : integer # 日志时间

    arg1 1 : CombatLog
    arg2 2 : RecvSkillDamage
}

.sChaosWarPlayer {
    userId 1 : integer
    name 2 : ColorText # 玩家名称
    avatar 3 : PlayerAvatar # 头像
    guildName 4 : ColorText # 公会名称 注意判空
    guildFlag 5 : GuildFlag # 公会旗帜 注意判空
    faction 6 : integer # 阵营

    power 7 : integer # 战力
    cityId 8 : integer # 所在城市id
    maxHp 9 : integer # 最大血量
    curHp 10 : integer # 当前血量
    honor 11 : integer # 军功
    title 12 : integer # 段位、军衔
    titleExp 13 : integer # 段位、军衔经验值
    attackTimes 14 : integer # 攻击次数
    defenseTimes 15 : integer # 防御次数
    coolingSkills 16 : *KVIntInt() # 冷却中的技能字典 skillId : expiry
    buffDict 17 : *sChaosWarBuff(id) # 玩家buff字典 键为buffId 
    logs 18 :  *sChaosWarLog # 战斗日志
    fuelCache 19 : integer # 炼油厂产出的 未进包燃料数量
}

.sChaosWarCity {
    .Defender {
        player 1 : sChaosWarPlayer # 玩家信息
        occupyRateDelta 2 : integer(3) # 占领率变化量
        coinDelta 3 : integer # 混沌币变化量
    }

    id 1 : integer
    faction 2 : integer

    localDefenderCnt 3 : integer # 守城人数
    combatIntensity 4 : integer(3) # 战斗烈度
    occupyRateDict 5 : *KVIntNum() # 占领率字典 键为阵营id 值为占领率(0.0 ~ 1.0)

    localDefenders 6 : *Defender # 守城玩家列表 注意: 仅ChaosWarCityDetail协议会填充此字段 
    remoteDefenders 7 : *Defender # 协防玩家列表 注意: 仅ChaosWarCityDetail协议会填充此字段
}

.sChaosWarGroup {
    seasonId 1 : integer
    seasonEndTime 2 : integer
    groupId 3 : integer
    cityDict 4 : *sChaosWarCity(id) # 城市字典 键为城市id 值为城市信息 注意: 守城、协防玩家列表是nil
    you 5 : sChaosWarPlayer # 你自己的玩家信息
    systemMsgList 6 : *sChaosWarMessage # 系统消息列表
    worldMsgList 7 : *sChaosWarMessage # 世界消息列表
    factionMsgList 8 : *sChaosWarMessage # 阵营消息列表
}

.sChaosWarMessage {
    .Chat {
        player 1 : sChaosWarPlayer # 玩家信息 userId, name, avatar, guildName, guildFlag, faction等字段有效
        args 2 : *string # 聊天内容 注意处理多语言
    }

    # 更新城市信息
    .UpdateCity {
        # 包含: id, faction, occupyRateDict, localDefenderCnt
        cityList 1 : *sChaosWarCity 
    }

    # 城市归属权变更
    .ExchangeCity {
        # 被占领城市
        # 包含: id, faction, occupyRateDict, localDefenderCnt
        occupiedCity 1 : sChaosWarCity 

        # 从occupiedCity清退的 上一阵营userId字典
        # 收到消息的客户端检查 若自己在这个字典中 那么就让自己退避到fallbackCityId对应的城市 
        fallbackPlayers 2 : *KVIntInt() 

        # 退避的目标城市id
        fallbackCityId 3 : integer
    }

    # 更新buff
    .UpdateBuff {
        type 1 : integer # 1增加或覆盖 2移除
        buff 2 : sChaosWarBuff
    }

    # 技能打击城市
    .SkillAttackCity {
        caster 1 : sChaosWarPlayer # 施法者 仅faction, name有效
        city 2 : sChaosWarCity # 城市 仅faction, id有效
        skillId 3 : integer # 技能id
    }

    channel 99 : integer # 频道: 1系统 2世界 3阵营
    type 98 : integer # 类型: 相见ChaosWarEnum.lua
    time 97 : integer # 事件发生时间

    arg1 1 : Chat
    arg2 2 : UpdateCity
    arg3 3 : ExchangeCity
    arg4 4 : *UpdateBuff
    arg5 5 : sChaosWarPlayer # 关键军衔更新
    arg6 6 : sChaosWarLog # 追加玩家日志
    arg7 7 : sChaosWarPlayer # 被击杀且踢回主城 除logs字段外其他字段有效
    arg8 8 : SkillAttackCity
    arg9 9 : *sChaosWarPlayer # 列表中的玩家需更新hp  userId, curHp, maxHp有效
}

.sChaosRankEntry {
    userId 1 : integer
    name 2 : ColorText # 玩家名称
    faction 3 : integer
    score 4 : integer # 分数
}


ChaosWarLogin 11100 {
    request {
    }
    response {
        state 1 : integer # 0:无赛季 1:备战阶段 2:开赛阶段 若state=0 则后续字段都无意义
        prepareEndTime 2 : integer # 准备阶段结束时间 当state = 1有意义
        seasonEndTime 3 : integer # 当前赛季结束时间 当state = 2有意义
        groupData 4 : sChaosWarGroup # 组数据 当state = 2有意义
        rankSize 5 : integer # 匹配池大小
    }
}

ChaosWarNotify 11101 {
    request {
        msg 1 : sChaosWarMessage
    }
}

ChaosWarChat 11102 {
    request {
        channel 1 : integer
        args 2 : *string # 聊天内容
    }
}

ChaosWarRankPull 11103 {
    request {
    }
    response {
        rankList 1 : *sChaosRankEntry # 排名列表
        yourRank 2 : integer # nil表示未上榜
    }
}


ChaosWarCityDetail 11110 {
    request {
        cityId 1 : integer
    }
    response {
        city 1 : sChaosWarCity # 城市信息
    }
}

ChaosWarCityMove 11111 {
    request {
        path 1 : *integer # 起点城市到终点城市的id列表
    }
    response {
        err 1 : integer
        player 2 : sChaosWarPlayer # cityId, title, titleExp有效
    }
}

ChaosWarCityQueryCombatIntensity 11112 {
    request {
    }
    response {
        dict 1 : *KVIntNum() # key是cityId value是战斗烈度
    }
}

# 收到通知 且type = kMsgTypeClaimFuel
# 调用此协议收取炼油厂产出的燃料 并加入本地背包
ChaosWarCityClaimFuel 11113 {
    request {
    }
    response {
        fuelCnt 1 : integer
    }
}


ChaosWarPlayerSkillUse 11115 {
    request {
        skillId 99 : integer # 技能id

        # 以cfg_chaos_playerskill.group为key 设置下列参数
        arg1 1 : integer # cityId
        arg2 2 : integer # cityId
        arg3 3 : integer # cityId
    }
    response {
        err 1 : integer
        cdExpiry 2 : integer # 更新后的技能cd过期时间 仅当err = kErrOk有意义
    }
}

ChaosWarPlayerSkillCheck 11116 {
    request {
        skillId 1 : integer # 技能id
    }
    response {
        err 1 : integer
    }
}


ChaosWarCombatBegin 11120 {
    request {
        cityId 1 : integer # 战斗所在城市id
        recverId 2 : integer # 被攻击玩家id
        isRemoteRecver 3 : boolean # 是否是协防玩家
        combatCount 4 : integer # 战斗次数
    }
    response {
        err 1 : integer
    }
}

ChaosWarCombatEnd 11121 {
    request {
        senderWin 1 : boolean # 进攻方是否胜利
        senderHpRatio 2 : integer(3) # 进攻方 损失的血量百分比
        senderShellRatio 3 : integer(3) # 进攻方 损失的护盾百分比
        recverHpRatio 4 : integer(3) # 防守方 损失的血量百分比
        recverShellRatio 5 : integer(3) # 防守方 损失的护盾百分比
    }
    response {
        occupyRateDelta 1 : integer(3) # 占领率变化量
        occupyRateDict 2 : *KVIntNum() # 占领率字典 键为阵营id 值为占领率(0.0 ~ 1.0)

        # 进攻方玩家信息(更新后)
        # 包含: name, avatar, curHp, maxHp, honor, title, titleExp, cityId, buffDict
        sender 3 : sChaosWarPlayer 
        senderHpDelta 4 : integer # 血量变化量
		senderExpDelta 5 : integer # 经验变化量
		senderCoinDelta 6 : integer # 混沌币变化量
		senderHonorDelta 7 : integer # 荣誉变化量

        # 防守方玩家信息(更新后)
        # 包含: name, avatar, curHp, maxHp, honor, title, titleExp, cityId, buffDict
        recver 8 : sChaosWarPlayer 
        recverHpDelta 9 : integer # 血量变化量
        recverKilled 10 : boolean # 是否被击杀
    }
}

