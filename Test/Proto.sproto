# 综合排行榜
WarRankOverall 7081 {
    request {
    }
    response {
        factionCityCnt 1 : *KVIntInt # 每个元素 key是阵营 val是城市数量
        guildRank 2 : *sWarRankGuild # 数组下边就是排位序号

        # 玩家相关的子榜单字段 可以是空数组
        # 数组下边就是排位序号
        honorRank 3 : *sWarRankPlayer 
        powerRank 4 : *sWarRankPlayer
        flagRank 5 : *sWarRankPlayer
        cureRank 6 : *sWarRankPlayer
        defendRank 7 : *sWarRankPlayer
        winRank 8 : *sWarRankPlayer
    }
}

