}

UVAShopShowAd 5100 {
    request {
        id 1 : integer
    }
}

UVAShopClaimRewards 5101 {
    request {
        id 1 : integer
    }
}

############################
# 公会 错误码
############################
#   0 ERR_OK 成功
#   1 ERR_NAME_SENSITIVE
#   2 ERR_NOTICE_SENSITIVE
#	3 ERR_RECRUIT_SENSITIVE
#	4 ERR_NAME_USED 名字已占用 
#	5 ERR_FULL 公会请求或成员已满
#	6 ERR_NOT_FOUND 未找到目标
#	7 ERR_NO_PERM 没有权限
#	8 ERR_UNSUPPORT 不支持的操作
#	9 ERR_JOINED 已加入
#	10 ERR_DISMISSED 公会已解散



#####################
# 公会
#####################

# 创建公会
GuildCreate 6000 {
    request {
        name 1 : ColorText
        visualType 2 : integer
        flag 3 : GuildFlag
        noticeInfo 4 : string
        recruitInfo 5 : string
    }
    response {
        # err的取值
        err 1 : integer # 见公会错误码
        
        # 当为ERR_OK时有意义 
        # 之后应立即调用GuildLogin 拉取公会存档
        guildId 2 : integer 
    }
}

# 登录公会
GuildLogin 6001 {
    request {}
    response {
        err 1 : integer # 见公会错误码
        guildData 2 : GuildData # 当为ERR_OK时有意义
    }
}

# 退出公会
GuildExit 6002 {
    request {}
    response {}
}

# 公会推送事件
GuildPushEvent 6003 {
    request {
        event 1 : GuildEvent
    }
}

# 公会聊天
GuildChat 6004 {
    request {
        text 1 : string
    }
}

# 公会加入 针对visualType=1的公会
GuildJoin 6005 {
    request {
        guildId 1 : integer
    }
    response {
        err 1 : integer
    }
}

# 发送入会申请
GuildRequest 6006 {
    request {
        guildId 1 : integer
    }
    response {
        err 1 : integer
    }
}

# 批准入会申请
GuildApprove 6007 {
    request {
        userId 1 : integer # 目标玩家id
    }
    response {
        err 1 : integer
    }
}

# 拒绝入会申请
GuildReject 6008 {
    request {
        userId 1 : integer
    }
    response {
        err 1 : integer
    }
} 

# 踢出公会
GuildKick 6009 {
    request {
        userId 1 : integer
    }
    response {
        err 1 : integer
    }
}

# 公会设置
GuildSetting 6010 {
    request {
        setting 1 : GuildData # 仅填充要用到的字段 从name到recruitInfo 
    }
    response {
        err 1 : integer
    }
}

# 任命 副会长
GuildAddManager 6011 {
    request {
        userId 1 : integer
    }
    response {
        err 1 : integer
    }
}

# 解任 副会长
GuildDelManager 6012 {
    request {
        userId 1 : integer
    }
    response {
        err 1 : integer
    }
}

# 升级科技项
GuildTechUpgrade 6013 {
    request {
        techId 1 : integer
    }
    response {
        err 1 : integer
    }
}

# 查找公会
GuildQuery 6014 {
    request {
        guildId 1 : integer
    }
    response {
        err 1 : integer
        guildData 2 : GuildData
    }
}

# 推荐公会 
GuildRecommend 6015 {
    request {}
    response {
        guildDatas 1 : *GuildData
    }
}

# 公会签到
GuildSignin 6016 {
    request {
        id 1 : integer # 配置表id
    }
}

# 公会通用商店
GuildBuyCommonShop 6017 {
    request {
        id 1 : integer # 配置表id
    }

}

# 取消公会申请
GuildCancelApply 6018 {
    request {
        guildId 1 : integer
    }
}

# 公会战商店购买
GuildBattleShopBuy 6019 {
    request {
        id 1 : integer
        count 2 : integer
    }
}

# 公会副本 更新伤害
GuildDungeonUpdateDamage 6020 {
    request {
        damage 1 : integer # 公会副本战斗后 产生伤害值
    }
    response {
        yourRank 1 : integer # 你在公会内的排位
    }
}

# 公会副本 公会榜单
GuildDungeonGuildRank 6021 {
    request {}
    response {
        list 1 : *GuildData # guildId, name, level, flag, dungeonDamage(此公会的总伤害)
        yourGuildRank 2 : integer # 你所在公会的排位 0表示未进入榜单
        yourGuildDamage 3 : integer # 你所在公会的总伤害
    } 
}

# 公会副本 成员榜单
GuildDungeonMemberRank 6022 {
    request {
    }
    response {
        list 1 : *sWarRankPlayer # userId, name, avatar, value(伤害值)
        yourRank 2 : integer # 你的排位 0表示未进入榜单
