####################################
# 资源战争
####################################

.ResourceWarUserData {
    # 用于业务逻辑的字段
    userId 1 : integer
    score 2 : integer   # 积分
    resCalcTime 3 : integer  # 最后一次资源计算时间
    resCount 4 : integer # 资源数量(用于玩家自行领取、其他玩家抢夺)
    power 5 : integer # 战力

    # 用于展示的字段
    name 20 : ColorText       # 玩家名称
    avatar 21 : PlayerAvatar  # 玩家头像
    title 22 : string         # 玩家称号

    guildName 23 : ColorText  # 公会名称 注意判空

}

.ResourceWarBattleLog {
    .PlayerInfo {
        userId 1 : integer
        name 2 : ColorText # 玩家名称
        avatar 3 : PlayerAvatar # 玩家头像
        guildName 4 : ColorText # 公会名称 注意判空
        scoreDelta 5 : integer # 积分变化量
        resourceDelta 6 : integer # 资源变化量
        power 7 : integer # 战力
    }

    time 1 : integer # 战斗时间
    isAttackerWin 2 : boolean # 进攻方是否胜利
    attacker 3 : PlayerInfo # 进攻方玩家信息
    defender 4 : PlayerInfo # 防守方玩家信息
}

.ResourceWarMessage {
    .MsgBattleEnd {
        userData 1 : ResourceWarUserData # 防守方战后数据
        userRank 2 : integer # 防守方战后排名
        logData 3 : ResourceWarBattleLog # 战斗日志数据
    }

    type 99 : integer

    arg1 1 : integer # 赛季战斗开始 该字段值无意义 收到消息后 客户端应再次调用ResourceWarLogin协议
    arg2 2 : MsgBattleEnd # 战斗结束 仅防守方收到该消息
}

.ResourceWarOpponent {
    opponentData 1 : ResourceWarUserData # 对手数据
    scoreDelta 2 : integer # 积分变化量
    resourceDelta 3 : integer # 资源变化量
}

ResourceWarLogin 11010 {
    request {
    }
    response {
        state 1 : integer # 0:无赛季 1:备战阶段 2:开赛阶段 若state=0 则后续字段都无意义
        prepareEndTime 2 : integer # 准备阶段结束时间 当state = 1有意义
        seasonEndTime 3 : integer # 当前赛季结束事件 当state = 2有意义
        battleLogs 4 : *ResourceWarBattleLog # 战斗日志列表 当state=2有意义
    }
}

ResourceWarClaimResource 11011 {
    request {
    }
    response {
        claimedResCount 1 : integer # 领取的资源数量 用于进包
        userData 2 : ResourceWarUserData # resCalcTime, resCount有更新
    }
}

ResourceWarNotify 11012 {
    request {
        msg 1 : ResourceWarMessage
    }
}

ResourceWarMatchOpponents 11013 {
    request {
    }
    response {
        opponents 1 : *ResourceWarOpponent  # 匹配结果
    }
}

ResourceWarBeginBattle 11014 {
    request {
        opponentId 1 : integer # 选定的对手玩家id
    }
    response {
        ok 1 : boolean # true:成功 false:失败,被其他玩家抢先
    }
}

ResourceWarEndBattle 11015 {
    request {
        isWin 1 : boolean # 是否胜利
    }
    response {
        scoreDelta 1 : integer # 积分变化量
        resourceDelta 2 : integer # 资源变化量 前端自行进包
        systemResourceDelta 3 : integer # 系统资源变化量 前端自行进包
        logData 4 : ResourceWarBattleLog # 战斗日志
        userData 5 : ResourceWarUserData # 战斗结束后玩家数据 resCount, resCalcTime有更新
        userRank 6 : integer # 战后排名
        opponentScoreDelta 7 : integer # 对手积分变化量
    }
}

ResourceWarRefreshUser 11016 {
    request {
    }
    response {
        userData 1 : ResourceWarUserData # 刷新后的玩家数据
        userRank 2 : integer # 刷新后的排名
    }
}

ResourceWarPullRankList 11017 {
    request {
    }
    response {
        rankList 1 : *ResourceWarUserData # 排名列表 数组下标就是排位序号
    }
}

