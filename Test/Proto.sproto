# 协议包头
.package {
    type 1 : integer  # 协议类型
    session 2 : integer  # 会话编号
    time 3 : integer(3)  # 时间戳
    error 4 : integer  # 错误码
    random 5 : integer  # 随机数哈希
    gold 6 : integer  # 金币检测
}

.KVIntBool {
    key 1 : integer
    val 2 : boolean
}

.KVIntInt {
    key 1 : integer
    val 2 : integer
}

.KVIntNum {
    key 1 : integer
    val 2 : integer(6)
}

.KVStrStr {
    key 1 : string
    val 2 : string
}

.KVStrInt {
    key 1 : string
    val 2 : integer
}

# 物品
.Item {
    type 1 : integer  # 物品类型
    count 2 : integer(3)  # 物品数量
}

.Color {
	r 1 : integer
	g 2 : integer
	b 3 : integer
}

.ColorText {
	color 1 : Color
	text 2 : string
    index 3 : integer # 颜色索引 默认0
}

.GuildFlag {
    .Layer {
        resId 1 : integer
	    color 2 : Color
    }

	bottom 1 : Layer
	middle 2 : Layer
	top    3 : Layer
}

.GuildMember {
	userId 1 : integer 
	name 2 : ColorText
	role 3 : integer  # 角色 与配置表对应
	power 4 : integer # 战力
	contr 5 : integer # 贡献
    joinTime 6 : integer # 加入时间
    loginTime 7 : integer # 最后登录时间
    avatar 8 : PlayerAvatar # 玩家头像
    logoutTime 9 : integer # 最后登出时间
}

.GuildChatInfo {
    userId 1 : integer
    text 2 : string
}

.GuildTech {
    id 1    : integer
    level 2 : integer
}

.UserIdPair {
    a 1 : integer
    b 2 : integer
}

.GuildTechUpgradeResult {
    tech 1 : GuildTech # 升级后的科技项
    techPt 2 : Item # 扣减后的科技点
}

.GuildCommonShop {
    .Goods {
        id 1 : integer # guild_shop表配置id
        itemIdx 2 : integer # 物品下标
        discountIdx 3 : integer # 折扣下标 
    }

    refreshTi 1 : integer # 下一次刷新的时间戳
    goodsList 2 : *Goods  # 商品列表
}

.GuildDungeon {
    resetTime 1 : integer # 重置超时时间戳
    totalDamage 2 : integer # 公会总伤害
    playerCount 3 : integer # 参与此副本的玩家数量
}

.GuildEvent {
    # type取值
    # 1 入会申请
    # 2 会员加入
    # 3 会员退出
    # 4 踢出会员
    # 5 任命副会长
    # 6 解任副会长
    # 7 超时退出
    # 8 会长变更
    # 9 聊天
    # 10 设置更新
    # 11 入会请求被拒
    # 12 成员属性更新
    # 13 成员签到
    # 14 科技项升级
    # 15 普通商店更新
    # 16 公会升级

    # 注意： type = [2,9] 应追加至GuildData对应字段

    type 1 : integer
    time 2 : integer
    
    arg1 3 : GuildMember
    arg2 4 : GuildMember
    arg3 5 : integer # 退出公会的userId
    arg4 6 : UserIdPair # a是发起踢出操作的userId b是目标userId
    arg5 7 : UserIdPair # 同理
    arg6 8 : UserIdPair # 同理
    arg7 9 : integer # 超时退出的userId
    arg8 10 : integer # 新会长的userId
    arg9 11 : GuildChatInfo
    arg10 12 : GuildData # 仅包含部分有效字段 从name到recruitInfo 
    arg11 13 : integer # 拒绝玩家的公会id
    arg12 14 : GuildMember
    arg13 15 : GuildData # 仅level, items字段有效
    arg14 16 : GuildTechUpgradeResult  # 见定义
    arg15 17 : GuildCommonShop
    arg16 18 : integer # 当时等级
    arg17 19 : integer # 成员登录 userId
    arg18 20 : integer # 成员登出 userId
    arg19 21 : GuildDungeon # 跨周期重置后的公会副本存档
    arg20 22 : integer # 更新后的 totalDamage
    arg21 23 : integer # 更新后的 playerCount
}

.GuildData {
	guildId 1 		: integer
	name 2 			: ColorText
	visualType 3 	: integer # 1公开 2隐藏 3需申请 
	flag 4 			: GuildFlag # 旗帜
	noticeInfo 5    : string # 公告信息 对内
	recruitInfo 6   : string # 招募信息 对外
	level 7         : integer # 公会等级
	members 9       : *GuildMember # 成员列表
	requests 10     : *GuildMember # 请求列表
    chatInfos 11    : *GuildEvent # 聊天信息
    sysInfos 12     : *GuildEvent # 系统信息
    techs   14      : *GuildTech # 科技列表 仅包含level>0的项

    # 物品列表 确定包含以下条目
    #   公会经验(到下一级的 已积累的经验)
    #   科技点
    items   15      : *Item 

    # 普通商店
    commonShop 16 : GuildCommonShop 

    power 17 : integer # 公会总战力 仅用于排行榜相关业务
    honor 18 : integer # 公会总军功 公会战需求

    dungeon 19 : GuildDungeon # 公会副本

    dungeonDamage 20 : integer # 副本总伤害 仅用于副本排行榜相关的请求上下文
}

# 公会申请
.GuildApplyJoin {
    id 1 : integer  # 公会编号
    name 2 : string  # 公会名字
    time 3 : integer  # 申请时间
}

# GM数据
.GMDataBody {
    .GMTowerUnlock {
        id 1 :integer # 炮台ID
        lv 2 :integer # 炮台等级默认1
        star 3 :integer # 炮台星级默认1
        talentLv 4 :integer # 炮台天赋等级默认1
    }
    items 1 : *KVIntInt() # 物品添加key=id,val=count
    towers 2 : *GMTowerUnlock(id) # 炮台解锁
    pveId 3 : integer # 解锁关卡ID
}

# 副本战斗数据
.DungeonBattleData {
    id 1 : integer # 副本ID
    diff 2: integer # 副本难度
    result 3: boolean # 是否完全胜利
    battleValue 4 : integer(6) # 战斗数值：击毁数量、收割程度、坚守时长、boss血量
    battleTarget 5 : integer(6) # 战斗数值目标
    titanList 6 : *integer # 泰坦列表
    bossTurn 7 : integer # 挑战boss波数
}

.PlayerAvatar {
    avatarId 1 : integer # 头像ID
    borderId 2 : integer # 头像边框ID
    badgeId 3 : integer # 称号ID
    avatarTime 4 : integer # 限时到期时间戳
    borderTime 5 : integer # 限时到期时间戳
    badgeTime 6 : integer# 限时到期时间戳
}

.tWorldCup {
    .SportsItem {
        id 1 : string # 赛事ID
        supportId 2 : string # 投注ID
        supportCnt 3 : integer # 投注金额
        flag 4 : boolean # 是否领取
    }
    .TaskItem {
        id 1 : integer # 任务ID
        count 2 : integer # 任务完成次数
        index 3 : integer # 任务档位
    }
    unlockTimer 1 : integer # 世界杯功能解锁时间戳
    # 离线挂机奖励（冠军之路）
    offlineTimer 2 : integer # 选择主队后离线时间戳
    # 赛事投注
    sportsBetting 3 : *SportsItem(id) # 赛事投注 key = 赛事ID value = 投注金额
    # 应援任务（每日任务&成就任务）
    dailyMission 4 : *TaskItem(id) # 日常任务 key = 任务ID value = 完成次数
    achieveMission 5 : *TaskItem(id) # 成就任务 key = 任务ID value = 完成次数
    # 应援商店（代币兑换）
    goodsItems 7 : *KVIntInt() # 商品物品 key = 已购买的商品ID value = 已购买的数量
    # 活动签到
    signInIndex 8 : integer # 签到索引
    signInTime 9 : integer # 下次签到时间戳
    # 确认主队
    mainTeamId 10 : string # 主队ID
    mainTeamTime 11 : integer # 主队确认时间戳
}

# "推箱子"大富翁
.tMonopoly {
    .Mission {
        id 1 : integer # 任务ID
        count 2 : integer # 累计计数
        index 3 : integer # 任务档位
    }
    .Pass {
        exp 1 : integer # 通行证经验
        index 2 : integer # 通行证已领取的档位
        ex_count 3 : integer # 通行证额外奖励领取次数
        pay1 4 : boolean # 付费通行证支付
    }

    .Robot {
        .Box {
            id 1 : integer
            boxId 2 : integer
            colorIndex 3 : integer
            index 4 : integer
        } 
        index 1 : integer
        betAmount 2 : integer
        sellBoxCount 3 : *KVIntInt()
        boxRewards 4 : *Box(id)
        turnProgress 5 : integer
        exBoxRewards 6 : *KVIntInt()
    }
    .Shop {
        .Page {
            id 1 : integer
            goodsList 2 : *KVIntInt()
        }
        level 1 : integer
        pageList 2 : *Page(id)
        costList 3 : *KVIntInt()
    }
    mission 1 : *Mission(id)
    pass 2 : Pass
    robot 3 : Robot
    tokens 4 : *KVIntInt()
    shop 5 : Shop
    starTimestamp 6 : integer
}

#周年庆
.tAnniversary {
    .PassInfo {
        count 1 : integer # 次数
        index 2 : integer # 索引
        purchased 3 : boolean # 是否已购买
    }
    .MissionItem {
        id 1 : integer # 任务ID
        count 2 : integer # 任务触发次数
        index 3 : integer # 任务领取索引
    }
    .ExchangeInfo {
        turn 1 : integer # 当前轮次
        round 3 : integer # 轮次累计值
        selects 2 : *KVIntInt() # key:组ID, value:选择的奖励序号(1/2/3)
    }
    .Throw {
        times 1 : integer # 投掷次数
        claimIndex 2 : integer # 投掷领取索引
        multipleIndex 3 : integer # 倍数索引
        effects 4 : *KVIntInt() # 投掷效果 key:value：进度ID
        pos 5 : *integer # 当前棋子位置
    }
    pass 1 : PassInfo
    mission 2 : *MissionItem(id)
    customHero 3 : *KVIntInt()
    shopGoods 4 : *KVIntInt()
    exchange 5 : ExchangeInfo
    throw 6 : Throw
    startTime 7 : integer # 活动开启时间戳
    chessboard 8 : *KVIntInt()
}

# 通行证任务
.tPassportTask {
    id 1 : integer # 任务id
    progress 2 : integer # 任务进度
    index 3 : integer # 索引
    finish 4 : boolean # 是否完成
}

#通行证
.tPassport {
    id 1 : integer  # 通行证id
    unlockPay1 2 : boolean # 解锁档位1
    claimIndex 3 : integer # 领取索引 指目标等级
    exp 4 : integer # 经验值
    weekExpLimit 5 : integer # 周经验上限
    level 6 : integer # 等级
    nextWeekly 7 : integer # 下周时间
    weeklyTask 8 : *tPassportTask(id) # 周任务列表
    periodTask 9 : *tPassportTask(id) # 本期任务列表
    unlockPay2 10 : boolean # 解锁档位2
}

#周年庆2
.tAnniversary2 {
    .tRebate {
        reward 1 : *Item()
        claimed 2 : *Item()
    }
    .tSign {
        loginDays 1 : integer # 已登录自然日天数
        lastDay 2 : integer # 上次登记的自然日零点时间戳
        claimed 3 : integer # 已领取份数
    }
    pass 1 : tPassport
    rebate 2 : tRebate
    goldsmith 3 : *KVIntInt() # 点金手 key：池子ID value：已领取档位默认1
    pilots 4 : *KVIntInt() # 驾驶员 key：驾驶员礼包ID value：购买次数
    gems 5 : *KVIntInt() # 钻石 key：池子ID value：已领取档位默认1
    titanPack 6 : *KVIntInt()
    sign 7 : tSign # 签到
}

# 玩家数据
.UserData {
    # 基础信息
    .Basic {
        appVersion 1 : string  # 应用版本号
        dataVersion 2 : integer  # 数据版本号
        updateVersion 3 : integer  # 更新版本号
        utcOffset 4 : integer  # UTC时差(秒)

        id 10 : integer  # 编号
        name 11 : string  # 名字
        lang 12 : string  # 语言
        uniqueID 13 : string # 唯一标示
        level 14 : integer # 账号等级
        exp 15 : integer # 账号经验
        headId 16 : integer # 头像ID
        changeNameCnt 17 : integer # 修改名字次数
        colorIndex 18 : integer # 颜色索引

        bornTime 20 : integer  # 创建时间
        loginTime 21 : integer  # 登录时间
        crossDayTime 22 : integer  # 跨天时间
        elapsedTime 23 :integer # 游戏流逝时间
        avatar 24 : PlayerAvatar # 头像信息

        randomSeed 30 : integer  # 随机种子
        
        genId 31 : integer #genId发生器，生成的genId自加1
        haveBindAcct 32 : boolean  # 是否已经绑定帐号
        
        showAdCnt 40 :integer # 观看广告次数
        beExtantCnt 41:integer # 留存次数

        # 订阅打点
        subscribe 50 : *KVStrInt()
        localData 51 : *KVStrInt() # 本地数据
    }

    # 新手引导
    .Tutorial {
        id 1 : integer # 引导id
        stage 2 : integer # 当前引导阶段
        finish 3 : boolean # 引导是否结束
        times 4 : integer # 引导次数
        giftTimes 5 : integer # 引导赠送次数
    }

    # 充值
    .Iap {
        # 已购商品
        .PurchasedProduct {
            productId 1 : string  # 商品编号
            purchaseTime 2 : integer  # 最后一次购买时间
            purchaseCount 3 : integer  # 周期内已经购买次数
        }

        totalRecharge 1 : integer(3)  # 累计充值金额
        dailyRecharge 2 : integer(3)  # 当日充值金额
        seasonRecharge 3 : integer(3)  # 赛季充值金额
        purchaseAllCount 4 : integer  # 累计支付次数
        totalClaimReward 5 : integer  # 累计充值金额领取奖励的

        pendingOrders 11 : *KVStrInt()  # 未确认订单,key:第三方ID，val:IAP配置ID
        purchasedProducts 12 : *PurchasedProduct(productId)  # 已购商品列表

        issueOrders 13 : *KVStrInt()  # 自动补单失败的问题订单 key:第三方ID，val:IAP配置ID
    }

    # 邮件
    .Mail {
        mailId 1 : integer  # 邮件编号
        userId 2 : integer  # 玩家编号

        startTime 3 : integer  # 开始时间
        expireTime 4 : integer  # 过期时间

        title 5 : string  # 邮件标题
        body 6 : string  # 邮件内容

        titleLoc 7 : *string  # 本地化标题
        bodyLoc 8 : *string  # 本地化内容

        itemList 9 : *Item  # 物品列表
        status 10 : integer  # 邮件状态 详情见Shared/Enum/MailStatus.lua

        appVersion 11 : string  # 游戏版本

        url 12 : string # 跳转链接 (注意判nil 以及空字符串)

        titleDict 13 : *KVStrStr() # gm后台发出的 原始本地化标题字典
        bodyDict 14  :*KVStrStr() # gm后台发出的 原始本地化正文字典
    }

    # 兑换码
    .CDKey {
        .KVStrItemList {
            cdkey 1 : string
            itemList 2 : *Item
        }
        pendingKeys 1 : *KVStrItemList()  # 未领取的兑换码
    }

    # 离线
    .Offline {
        offlineTime 1 : integer  # 离线时间
        elapsedTime 2 : integer  # 离线时长
    }

    # 塔
    .Tower {
        id 1 : integer  # 炮台ID
        sn 2 : integer  # 炮台序列号
        star 3 : integer # 炮台星级
        pos 4 : integer  # 炮台位置
        lock 5 : boolean  # 炮台锁定状态，上锁后不能被合并
    }

    # 等级信息
    .LevelInfo {
        id 1 : integer  # 炮台ID
        lv 2 : integer  # 炮台等级
        reformHp 3 : integer(6)  # 当前阶段改造的炮台生命值
        reformDmg 4 : integer(6)  # 当前阶段改造的炮台伤害值
        reformShield 5 : integer(6)  # 当前阶段改造的炮台护甲值
        talents 6 : *KVIntInt()  # 炮台已解锁天赋<编号,等级>
        reforms 7 : *KVIntInt()  # 炮台改造<阶段,次数,保底次数>
    }

    # 阵容
    .Formation {
        id 1 : integer  # 阵容编号
        towers 2 : *KVIntInt()  # 炮台列表
        titans 3 : *KVIntInt()  # 泰坦列表
    }

    .WorldProduct {
        id 1 : integer  # 物品ID
        time 2 : integer  # 物品领取时间戳
        remainCount 3 : integer(3)  # 物品剩余数量
        index 4 : integer #产品下标
    }

    .WorldChapter {
        id 1 : integer  # 章节ID
        star 2 : integer  # 章节星级
        smallStatus 3 : *boolean # 小关卡通关状态
        bigStar 4 : integer  # 大关卡星级
    }

    .WorldBubble {
        pos 1 : integer  # 气泡位置
        rewardItem 2 : Item # 气泡奖励
        endTime 3 : integer  # 气泡结束时间
    }

    .WorldEvent {
        pos 1 : integer  # 事件位置
        type 2 : integer # 事件类型
        rewards 3 : *Item # 事件奖励列表
        endTime 4 : integer  # 事件结束时间
        enemyUid 5 : integer # 敌人userId
        nameId 6 : integer # 敌人名字id
    }

    .World {
        chapters 1 : *WorldChapter(id) # 章节列表
        rewardIndex 2 : integer  # 奖励领取星级
        products 3 : *WorldProduct  # 产出列表
        buffStar 4 : integer  # buff激活星数
        accelerateTimes 5 : integer  # 加速生产剩余次数
        accelerateAdTimes 6 : integer  # 加速生产剩余广告次数
        receiveTime 7 : integer  # 产出领取时间
        questLevel 8 : integer  # 委托等级
        bubbleList 9 : *WorldBubble # 气泡列表
        bubbleNextTime 10 : integer # 气泡下次生成时间
        eventList 11 : *WorldEvent # 事件列表
        eventNextTime 12 : integer # 事件下次生成时间
        pvpTimes 13 : integer # PVP次数
        vipAccelerateTimes 14 : integer # 广告加速次数
    }

    # 双倍回收机
    .DoubleRecycle {
        list 1 : *integer # 回收列表
        adTime 2 : integer # 下次广告时间
    }

    #主线
    .Pve {
        id 1 : integer # 当前关卡ID
        clear 2 : boolean # 当前是否通关
        dayFailTimes 3 : integer # 每日失败次数
        doubleRecycle 4 : DoubleRecycle # 主线双倍回收机
        victoryTimes 5 : integer # 连胜次数
        victoryRate 6 : integer(3) # 连胜增幅值
        chapterPack 7 : integer # 当前章节礼包id
        chapterPackClear 8 : boolean # 章节礼包是否清空
        is_perfect 9 : boolean # 是否 Perfect
        chapterPackList 10 : *KVIntBool() #章节礼包购买状态
    }

    # 副本
    .Dungeon {
        id 1 : integer # 副本ID
        adCount 2 : integer # 广告次数
        refreshTime 3 : integer # 刷新时间
        score 4 : integer # 分数
        unlockDiff 5 : integer # 难度状态
        selectDiff 6 : integer # 当前难度
        rewardsStatus 7 : *boolean # 奖励领取状态
        dayFree 8 : integer # 每日免费使用次数
        recordTitans 9 : *integer # 记录的挑战泰坦
        recordDiff 10 : integer # 记录的挑战难度
        bossTurn 11 : integer # 挑战boss波次
     }

    # 要塞装备、技能穿戴孔
    .Fortress {
        equipSlots 1 : *KVIntInt()
        skillSlots 2 : *KVIntInt()
    }

    # 要塞装备
    .FortressEquip {
        id 1 : integer
        sn 2 : integer
        lv 3 : integer
        rare 4 : integer
        using 5 : boolean
    }

    # 要塞技能
    .FortressSkill {
        id 1 : integer
        sn 2 : integer
        rare 3 : integer
        slot 4 : integer
    }

    # 商店 常规商品购买记录
    .GoodsRecord {
        id 1 : integer
        adTi 2 : integer
        adCnt 3 : integer
        freeCnt 4 : integer
        buyCnt 5 : integer
    }

    # 商店 扭蛋机购买记录
    .GachaRecord {
        id 1 : integer
        adTi 2 : integer
        adCnt 3 : integer
        bd10Cnt 4 : integer
        bd100Cnt 5 : integer
        buyCnt 6 : integer
        trialState 7 : integer
    }

    # 事件存档
    .EventArchive {
        id 1 : integer # 事件id
        data 2 : *KVIntInt() # 事件数据
    }

    .MissionMain {
        id 1 : integer # 当前所在主线id
        data 2 : *KVIntInt() # 事件数据
        clear 3 : boolean # 主线任务通关
    }
    

    .MissionDailyItem {
        id 1 : integer # 任务id
        progress 2 : integer # 任务进度
        isReceived 3 : boolean # 是否领取任务奖励
    }

    .MissionDaily {
        missionList 1 : *MissionDailyItem(id) # 任务列表
        isReceived 2 : boolean # 是否领取每日委托奖励
        dayLevel 3 : integer # 当日任务委托等级
        completeTimes 4 : integer # 每日任务完成次数
    }

    .Mission {
        main 1 : MissionMain # 主线
        daily 2 : MissionDaily # 日常任务
    }

    .LibraryMission {
        id 1 : integer # 任务id
        curId 2 : integer # 当前任务id
        rewardIndex 3 : integer # 奖励领取位置
    }

    .LibraryResearch {
        index 1 : integer # 索引
        researchId 2 : integer # 研究蓝图id
        researchEndTime 3 : integer # 研究结束时间
        isAdAccelerate 4 : boolean # 是否使用广告加速
    }

    .Library {
        missions 1 : *LibraryMission(id) # 档案列表
        researchId 2 : integer # 当前研究蓝图id
