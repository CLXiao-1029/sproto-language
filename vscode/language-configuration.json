{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["(", ")"]],
  "autoClosingPairs": [{ "open": "{", "close": "}" }, { "open": "(", "close": ")" }],
  "surroundingPairs": [["{", "}"], ["(", ")"]],
  "wordPattern": "[A-Za-z_][A-Za-z_0-9]*(?:\\.[A-Za-z_][A-Za-z_0-9]*)*",
  "indentationRules": { "increaseIndentPattern": "\\{[^}#]*(?:#.*)?$", "decreaseIndentPattern": "^\\s*\\}" }
}
